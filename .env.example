# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_PASSWORD=change_me_in_production

# ─────────────────────────────────────────
# Cloudflare (set via wrangler.toml or CF dashboard, not here)
# DB and ASSETS bindings are injected by the runtime
# ─────────────────────────────────────────
# These are here for reference only — do NOT put CF binding secrets here
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# ─────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─────────────────────────────────────────
# Printful (only needed if using POD products)
# ─────────────────────────────────────────
PRINTFUL_API_KEY=

# ─────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=orders@yourdomain.com
