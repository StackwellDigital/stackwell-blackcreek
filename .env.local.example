# Copy this to .env.local and fill in your values
# These are PUBLIC vars — safe to expose to the browser

NEXT_PUBLIC_SHOP_NAME="The Barbershop"
NEXT_PUBLIC_MULTI_STAFF="false"
NEXT_PUBLIC_BOOKING_WINDOW_DAYS="14"
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# For local dev with wrangler, secrets go via: wrangler secret put SECRET_NAME
# ADMIN_PASSWORD=
# RESEND_API_KEY=
