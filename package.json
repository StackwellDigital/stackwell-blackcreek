{
  "name": "stackwell-booking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "preview": "npm run pages:build && wrangler pages dev",
    "deploy": "npm run pages:build && wrangler pages deploy",
    "db:create": "wrangler d1 create stackwell-booking",
    "db:migrate": "wrangler d1 execute stackwell-booking --file=./migrations/001_init.sql",
    "db:migrate:remote": "wrangler d1 execute stackwell-booking --remote --file=./migrations/001_init.sql",
    "db:studio": "wrangler d1 execute stackwell-booking --command='SELECT * FROM bookings ORDER BY booking_date, booking_time'"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "wrangler": "^3.91.0"
  }
}
